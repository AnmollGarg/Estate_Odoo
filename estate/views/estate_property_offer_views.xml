<odoo>
    <record id="real_estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">real_estate_property_offer.list</field>
        <field name="model">real_estate_property_offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" editable="bottom">
                 <field name="buyer_id"/>
                <field name="price"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                 <button name="action_confirm" type="object" icon="fa-check" invisible="status != False"/>
                <button name="action_refused" type="object" icon="fa-times" invisible="status != False"/>
                 <field name="status"/>
            </list>
        </field>
    </record>


     <record id="real_estate_property_offer_form_view" model="ir.ui.view">
        <field name="name">real_estate_property_offer.form</field>
        <field name="model">real_estate_property_offer</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <group>
                       <field name="buyer_id"/>
                <field name="price"/>
                        <field name="validity"/>
                <field name="date_deadline"/>
                 <field name="status"/>
                          </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>