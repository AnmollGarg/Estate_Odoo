<odoo>
    <record id="real_estate_property_tags_list_view" model="ir.ui.view">
        <field name="name">real_estate_property_tags.list</field>
        <field name="model">real_estate_property</field>
        <field name="arch" type="xml">
            <list string="Property Tags" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>


     <record id="real_estate_property_tags_form_view" model="ir.ui.view">
        <field name="name">real_estate_property_tags.form</field>
        <field name="model">real_estate_property_tags</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <group>
                        <group>
                            <h1><field name="name"/></h1>
                            </group>
                          </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_property_tags_action" model="ir.actions.act_window">
        <field name="name">Properties Tags</field>
        <field name="res_model">real_estate_property_tags</field>
        <field name="view_mode">list,form</field>

    </record>
</odoo>