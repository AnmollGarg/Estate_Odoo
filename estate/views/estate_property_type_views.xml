<odoo>
    <record id="real_estate_property_offer_stat_action" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">real_estate_property_offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <record id="real_estate_property_type_list_view" model="ir.ui.view">
        <field name="name">real_estate_property_type.list</field>
        <field name="model">real_estate_property</field>
        <field name="arch" type="xml">
            <list string="Property Type">
                <field name="name"/>
            </list>
        </field>
    </record>


     <record id="real_estate_property_type_form_view" model="ir.ui.view">
        <field name="name">real_estate_property_type.form</field>
        <field name="model">real_estate_property_type</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(real_estate_property_offer_stat_action)d" type="action" class="oe_stat_button" icon="fa-money">
                            <field name="offer_count" widget="statinfo" string="Offers"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <h1><field name="name"/></h1>
                            </group>
                          </group>
                     <notebook>
                        <page string="Properties">
                            <field name="property_ids">
                                <list string="Properties">
                                    <field name="name"/>
                                    <field name="expected_price"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Properties Type</field>
        <field name="res_model">real_estate_property_type</field>
        <field name="view_mode">list,form</field>

    </record>
</odoo>